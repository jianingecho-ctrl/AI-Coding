{
  "name": "workplace-little-judge-unified",
  "version": "0.12.0",
  "private": true,
  "description": "职场小判官：比奇堡与甄嬛传双主题，分档保存",
  "author": "职场小判官",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:native && npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --dir tests",
    "build": "npm run typecheck && vite build && npm run build:electron && npm run build:native",
    "start": "electron .",
    "pack:mac": "npm run build && node scripts/build-native.mjs --all-arch && electron-builder --mac",
    "test:desktop": "npm run build && node tests/desktop.cjs",
    "sources": "node scripts/export-editions.mjs",
    "test:isolation": "npm run build && node tests/isolation.cjs",
    "build:native": "node scripts/build-native.mjs",
    "test:notifications": "npm run build && node tests/notifications-desktop.cjs",
    "test:priority": "npm run build && node tests/priority-interactions-desktop.cjs",
    "test:unified": "npm run build && node tests/unified-desktop.cjs",
    "pack:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:win:dir": "npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "cn.workplace.littlejudge.unified",
    "productName": "职场小判官",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "edition.json",
      "!node_modules/lottie-web/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**"
    ],
    "directories": {
      "output": "release/unified"
    },
    "afterPack": "scripts/windows-after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extraResources": [
        {
          "from": "native/bin",
          "to": "notification-tools",
          "filter": [
            "NotificationCapture-arm64",
            "NotificationCapture-x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WorkJudge-Setup-${version}-${arch}.${ext}",
      "icon": "public/characters/npc.png",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "native/windows",
          "to": "notification-tools/windows",
          "filter": [
            "NotificationCapture.ps1"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "职场小判官",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "script": "build/windows-installer.nsi"
    }
  }
}
