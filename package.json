{
  "name": "workplace-little-judge-ocean",
  "version": "0.8.0",
  "private": true,
  "description": "职场小判官·海洋版：独立桌面应用",
  "author": "职场小判官",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --dir tests",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac",
    "test:desktop": "npm run build && node tests/desktop.cjs",
    "sources": "node scripts/export-editions.mjs",
    "test:isolation": "npm run build && node tests/isolation.cjs"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "cn.workplace.littlejudge.ocean",
    "productName": "职场小判官·海洋版",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "edition.json",
      "!dist/characters/palace_*.png"
    ],
    "directories": {
      "output": "release/ocean"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    }
  }
}
